page {
  background: #07111f;
  color: #f8fafc;
  font-family: Arial, Helvetica, sans-serif;
}

.container {
  min-height: 100vh;
  padding: 32rpx;
  background:
    radial-gradient(circle at top left, rgba(78, 120, 255, 0.25), transparent 32%),
    radial-gradient(circle at top right, rgba(11, 211, 255, 0.18), transparent 28%),
    linear-gradient(180deg, #0a1324 0%, #07111f 58%, #050b14 100%);
}

.hero-card,
.card {
  position: relative;
  background: rgba(10, 19, 36, 0.78);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.28);
  backdrop-filter: blur(12rpx);
}

.hero-card::after,
.card::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 32rpx;
  pointer-events: none;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #dbeafe;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.title {
  margin-top: 20rpx;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.22;
  color: #ffffff;
}

.subtitle {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #b8c4d7;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  color: #f8fafc;
}

.btn-primary {
  margin-top: 28rpx;
  background: linear-gradient(135deg, #6f7cff 0%, #34d3ff 100%);
  color: #081120;
  border-radius: 999rpx;
  padding: 24rpx 32rpx;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
}

.btn-secondary {
  margin-top: 20rpx;
  background: rgba(255, 255, 255, 0.04);
  color: #f8fafc;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 999rpx;
  padding: 22rpx 32rpx;
  font-size: 28rpx;
}

.option {
  display: block;
  width: 100%;
  text-align: left;
  padding: 24rpx;
  margin-top: 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: #f8fafc;
  font-size: 28rpx;
  line-height: 1.6;
}

.option.active {
  border-color: rgba(111, 124, 255, 0.9);
  background: rgba(111, 124, 255, 0.12);
  box-shadow: 0 0 0 1rpx rgba(111, 124, 255, 0.2) inset;
}

.kpi {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  font-size: 28rpx;
  color: #dbe5f4;
}

.input {
  margin-top: 20rpx;
  background: rgba(255, 255, 255, 0.04);
  color: #f8fafc;
  border-radius: 18rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.label {
  margin-top: 24rpx;
  display: block;
  font-size: 26rpx;
  color: #d7e3f5;
}

.tag {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(52, 211, 255, 0.12);
  color: #8ce9ff;
  margin-right: 12rpx;
  margin-top: 12rpx;
  font-size: 24rpx;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-top: 28rpx;
}

.stat-card {
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.stat-value {
  font-size: 42rpx;
  font-weight: 700;
  color: #ffffff;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9fb0c8;
}

.type-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 24rpx;
}

.type-card {
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.type-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
}

.type-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #aebdd3;
}

.cta-note {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8ea4c4;
}

.result-hero {
  padding-top: 8rpx;
}

.score-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  color: #dbeafe;
  font-size: 24rpx;
  margin-top: 18rpx;
}

.list-item {
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #c7d4e6;
}
