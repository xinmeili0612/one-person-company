page {
  background: #f8f7f2;
  color: #1f2937;
  font-family: Arial, Helvetica, sans-serif;
}

.container {
  padding: 32rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.3;
}

.subtitle {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #4b5563;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.btn-primary {
  margin-top: 32rpx;
  background: #111827;
  color: #fff;
  border-radius: 999rpx;
  padding: 24rpx 32rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-secondary {
  margin-top: 24rpx;
  background: #fff;
  color: #111827;
  border: 2rpx solid #d1d5db;
  border-radius: 999rpx;
  padding: 22rpx 32rpx;
  font-size: 28rpx;
}

.option {
  display: block;
  width: 100%;
  text-align: left;
  padding: 24rpx;
  margin-top: 20rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 2rpx solid #e5e7eb;
  font-size: 28rpx;
  line-height: 1.5;
}

.option.active {
  border-color: #111827;
  background: #f3f4f6;
}

.kpi {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f3f4f6;
  font-size: 28rpx;
}

.input {
  margin-top: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 2rpx solid #e5e7eb;
}

.label {
  margin-top: 24rpx;
  display: block;
  font-size: 26rpx;
  color: #374151;
}

.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #e5e7eb;
  margin-right: 12rpx;
  margin-top: 12rpx;
  font-size: 24rpx;
}
