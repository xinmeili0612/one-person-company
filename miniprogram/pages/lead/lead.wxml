<view class="container">
  <view class="card">
    <view class="title">领取专属行动清单</view>
    <view class="subtitle">留一个联系方式，我们把更细的行动建议发给你。</view>

    <view class="label">昵称（选填）</view>
    <input class="input" placeholder="怎么称呼你" data-field="nickname" bindinput="onInput" />

    <view class="label">手机号（选填）</view>
    <input class="input" type="number" placeholder="输入手机号" data-field="phone" bindinput="onInput" />

    <view class="label">微信号（选填）</view>
    <input class="input" placeholder="输入微信号" data-field="wechatId" bindinput="onInput" />

    <view class="label">你当前最大的卡点（选填）</view>
    <textarea class="input" auto-height placeholder="比如：有技能，但不知道怎么卖第一单" data-field="painPoint" bindinput="onInput"></textarea>

    <button class="btn-primary" bindtap="submitLead">提交并领取</button>
  </view>
</view>
